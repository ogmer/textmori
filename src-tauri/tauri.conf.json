{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "textmori",
  "version": "0.1.0",
  "identifier": "com.ogmer.textmori",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "textmori",
        "width": 960,
        "height": 680,
        "minWidth": 420,
        "minHeight": 280,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJBRDBENDc2NzVFRDMyMkMKUldRc011MTFkdFRRdXRDbVV4NDVQNmVZMW5RVDN1dXEvUUNwRE5mRUVpdGNVckVlME9XRzdSSjQK",
      "endpoints": [
        "https://github.com/ogmer/textmori/releases/latest/download/latest.json"
      ]
    }
  }
}
